@page
@using AccessHub.API.Pages.Account
@model AccessHub.API.Pages.Account.ConsentModel
@{}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authorize Application</title>
    <style>
        :root {
            --bg: #f3f4f6;
            --card-bg: #ffffff;
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #6b7280;
            --secondary-dark: #4b5563;
            --text: #111827;
            --text-light: #6b7280;
            --radius: 16px;
            --shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card {
            width: 420px;
            background: var(--card-bg);
            padding: 40px 32px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            animation: fadeIn 0.6s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            margin: 0 0 10px;
            font-size: 26px;
            color: var(--text);
        }

        .subtitle {
            margin-bottom: 28px;
            font-size: 14px;
            color: var(--text-light);
        }

        .app-info {
            margin-bottom: 24px;
            padding: 16px;
            background: #f9fafb;
            border-radius: 12px;
        }

        .app-info strong {
            color: var(--text);
            font-size: 16px;
            display: block;
            margin-bottom: 4px;
        }

        .app-info p {
            margin: 0;
            color: var(--text-light);
            font-size: 14px;
        }

        fieldset {
            border: none;
            padding: 0;
            margin-bottom: 24px;
        }

        legend {
            font-size: 16px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 16px;
            display: block;
        }

        .scope-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            padding: 12px;
            background: #f9fafb;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .scope-item:hover {
            background: #f3f4f6;
        }

        .scope-item input[type="checkbox"] {
            margin-right: 12px;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .scope-item label {
            cursor: pointer;
            color: var(--text);
            font-size: 14px;
            flex: 1;
        }

        .actions {
            display: flex;
            gap: 12px;
            margin-top: 32px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            font-size: 16px;
            border: none;
            cursor: pointer;
            border-radius: var(--radius);
            transition: 0.2s;
            font-weight: 500;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-secondary {
            background: var(--secondary);
            color: white;
        }

        .btn-secondary:hover {
            background: var(--secondary-dark);
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Authorize Application</h2>
        <div class="subtitle">Review and confirm the requested permissions</div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Scopes" />

            <div class="app-info">
                <strong>@Model.ApplicationName</strong>
                <p>请求访问你的账户数据</p>
            </div>

            <fieldset>
                <legend>请求权限</legend>
                @foreach (var scope in Model.Scopes)
                {
                    <div class="scope-item">
                        <input type="checkbox" checked disabled />
                        <label>@scope</label>
                    </div>
                }
            </fieldset>

            <div class="actions">
                <button class="btn btn-secondary" type="submit" name="action" value="no">拒绝授权</button>
                <button class="btn btn-primary" type="submit" name="action" value="yes">同意授权</button>
            </div>
        </form>
    </div>
</body>
</html>
