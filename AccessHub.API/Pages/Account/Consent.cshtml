@page
@using AccessHub.API.Pages.Account
@model AccessHub.API.Pages.Account.ConsentModel
@{
    ViewData["Title"] = "Authorize Application";
}
<h2>Authorize Application</h2>

<p><strong>@Model.ApplicationName</strong> 请求访问你的账户数据:</p>

<form method="post">
    
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Scopes" />

    <fieldset>
    <legend>请求权限</legend>
    @foreach (var scope in Model.Scopes)
    {
        <div>
            <input type="checkbox" checked disabled />
            <label>@scope</label>
        </div>
    }
    </fieldset>

    <button type="submit" name="action" value="yes">同意授权</button>
    <button type="submit" name="action" value="no">拒绝授权</button>
</form>
